    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const d = item.json;\n\n  const spend = Number(d[\"Spend ($)\"] ?? d.Spend);\n  const clicks = Number(d.Clicks);\n  const impressions = Number(d.Impressions);\n  const leads = Number(d.Leads);\n  const sales = Number(d.Sales);\n\n  const ctr = impressions > 0 ? (clicks / impressions) * 100 : 0;\n  const conversionRate = clicks > 0 ? (leads / clicks) * 100 : 0;\n  const costPerLead = leads > 0 ? spend / leads : null;\n  const costPerSale = sales > 0 ? spend / sales : null;\n\n  return {\n    json: {\n      ...d,\n      CTR: Number(ctr.toFixed(4)),\n      ConversionRate: Number(conversionRate.toFixed(4)),\n      CostPerLead: costPerLead === null ? null : Number(costPerLead.toFixed(4)),\n      CostPerSale: costPerSale === null ? null : Number(costPerSale.toFixed(4))\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
